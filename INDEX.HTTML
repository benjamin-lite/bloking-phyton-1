<!DOCTYPE html>
<html lang="id">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Portofolio Pribadi</title>

<style>
*{
    margin:0;
    padding:0;
    box-sizing:border-box;
    font-family:'Segoe UI', sans-serif;
}

body{
    background:#f4f7fb;
    color:#333;
    line-height:1.6;
}

header{
    background:linear-gradient(135deg,#2563eb,#7c3aed);
    color:white;
    text-align:center;
    padding:80px 20px;
}

header h1{
    font-size:3rem;
}

header p{
    font-size:1.2rem;
    margin-top:10px;
}

.container{
    width:90%;
    max-width:1100px;
    margin:auto;
    padding:40px 0;
}

.section-title{
    text-align:center;
    margin-bottom:30px;
    color:#2563eb;
    font-size:2rem;
}

.card{
    background:white;
    padding:25px;
    border-radius:15px;
    box-shadow:0 5px 15px rgba(0,0,0,0.1);
    margin-bottom:25px;
    transition:0.3s;
}

.card:hover{
    transform:translateY(-5px);
}

.timeline-item{
    margin-bottom:20px;
    border-left:4px solid #2563eb;
    padding-left:15px;
}

.timeline-item h3{
    color:#2563eb;
}

.projects{
    display:grid;
    grid-template-columns:repeat(auto-fit,minmax(250px,1fr));
    gap:20px;
}

.project-card{
    background:white;
    border-radius:15px;
    overflow:hidden;
    box-shadow:0 5px 15px rgba(0,0,0,0.1);
    transition:0.3s;
}

.project-card:hover{
    transform:scale(1.03);
}

.project-card img{
    width:100%;
    height:180px;
    object-fit:cover;
}

.project-content{
    padding:20px;
}

.project-content h3{
    color:#2563eb;
    margin-bottom:10px;
}

footer{
    text-align:center;
    background:#111827;
    color:white;
    padding:20px;
    margin-top:40px;
}
</style>
</head>

<body>

<header>
    <h1>Nama Anda</h1>
    <p>Web Developer | UI/UX Designer | Freelancer</p>
</header>

<div class="container">

    <!-- Tentang Saya -->
    <section>
        <h2 class="section-title">Tentang Saya</h2>
        <div class="card">
            <p>
                Saya adalah seorang profesional yang memiliki minat dalam
                pengembangan web, desain antarmuka, dan teknologi digital.
                Berpengalaman dalam mengembangkan aplikasi dan website yang
                modern serta responsif.
            </p>
        </div>
    </section>

    <!-- Pendidikan -->
    <section>
        <h2 class="section-title">Pendidikan</h2>
        <div class="card">
            <div class="timeline-item">
                <h3>S1 Teknik Informatika</h3>
                <p>Universitas XYZ (2018 - 2022)</p>
            </div>

            <div class="timeline-item">
                <h3>SMA Negeri ABC</h3>
                <p>Jurusan IPA (2015 - 2018)</p>
            </div>
        </div>
    </section>

    <!-- Pengalaman Kerja -->
    <section>
        <h2 class="section-title">Pengalaman Kerja</h2>
        <div class="card">

            <div class="timeline-item">
                <h3>Frontend Developer</h3>
                <p>PT Teknologi Indonesia (2023 - Sekarang)</p>
                <p>
                    Mengembangkan website perusahaan menggunakan HTML, CSS,
                    JavaScript, dan framework modern.
                </p>
            </div>

            <div class="timeline-item">
                <h3>Web Developer Intern</h3>
                <p>Startup Digital XYZ (2022 - 2023)</p>
                <p>
                    Membantu pembuatan landing page dan dashboard admin.
                </p>
            </div>

        </div>
    </section>

    <!-- Hasil Karya -->
    <section>
        <h2 class="section-title">Hasil Karya</h2>

        <div class="projects">

            <div class="project-card">
                <img src="https://picsum.photos/400/250?1" alt="Project 1">
                <div class="project-content">
                    <h3>Website Company Profile</h3>
                    <p>
                        Website profil perusahaan dengan desain modern dan responsif.
                    </p>
                </div>
            </div>

            <div class="project-card">
                <img src="https://picsum.photos/400/250?2" alt="Project 2">
                <div class="project-content">
                    <h3>Aplikasi Kasir</h3>
                    <p>
                        Sistem kasir berbasis web untuk UMKM dengan laporan otomatis.
                    </p>
                </div>
            </div>

            <div class="project-card">
                <img src="https://picsum.photos/400/250?3" alt="Project 3">
                <div class="project-content">
                    <h3>Dashboard Analytics</h3>
                    <p>
                        Dashboard visualisasi data menggunakan grafik interaktif.
                    </p>
                </div>
            </div>

        </div>
    </section>

</div>

<footer>
    <p>&copy; 2025 Nama Anda | Portfolio Website</p>
</footer>

</body>
</html>
